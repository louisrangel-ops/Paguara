DATABASE_URL=postgres://postgres:postgres@localhost:5432/pasarela
REDIS_URL=redis://localhost:6379
# Obligatorio y propio fuera de local: `openssl rand -hex 32` (la API no arranca con este valor de ejemplo)
INTERNAL_API_TOKEN=cambia-esto
PORT=3000
# false = sandbox (solo llaves sk_test_/pk_test_), true = producción (solo llaves live). Cada uno con su propia base.
LIVEMODE=false
# Spread cambiario al convertir liquidaciones (120 = 1,2 %)
FX_PAYOUT_SPREAD_BPS=120
FX_MAX_RATE_AGE_SECONDS=21600
# URL pública del sitio (links de pago y checkout). Sin definir, se usa la del pedido.
PUBLIC_BASE_URL=https://pagos.ejemplo.com
# Contacto para reportar vulnerabilidades (/.well-known/security.txt). Sin ella, 404.
# SECURITY_CONTACT=mailto:seguridad@tu-dominio.com
# Dashboard del otro modo (sandbox ↔ producción) para el selector "modo de prueba"
OTHER_MODE_DASHBOARD_URL=
# Solo desarrollo local en http: cookies sin Secure, webhooks a http:// y a la red interna
COOKIE_SECURE=true
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE=false
# Detrás de un balanceador, para la IP real en los límites de intentos (p. ej. 1)
TRUST_PROXY=
# Gestor de llaves para los secretos guardados en la base (webhooks, 2FA, bancos): local (desarrollo) o aws (obligatorio con LIVEMODE=true)
KMS_PROVIDER=local
# Con aws: ARN, id o alias de la llave en AWS KMS, y su región. Credenciales por el rol del servicio.
# KMS_KEY_ID=alias/paguara-secrets
# AWS_REGION=us-east-1
# Llave local (KMS_PROVIDER=local): `openssl rand -hex 32`. Con aws, solo mientras queden secretos viejos por migrar.
# Va en el gestor de secretos del hosting, nunca en la base ni en el repo.
SECRETS_ENCRYPTION_KEY=
# Llaves locales anteriores (separadas por coma) durante una rotación, hasta correr `npm run secrets:rewrap`
SECRETS_ENCRYPTION_PREVIOUS_KEYS=
# Horas que dura la sesión de un operador en /admin (máximo 24)
OPERATOR_SESSION_HOURS=8
# Webhook (Slack, Teams, Discord, Google Chat) que recibe las alertas de conciliación y certificados
ALERT_WEBHOOK_URL=
# Conciliación: días hacia atrás que revisa y días de gracia antes de marcar un cobro sin crédito
RECON_LOOKBACK_DAYS=7
RECON_GRACE_DAYS=0
# Puerto privado donde se sirven /internal y /admin (en el público dan 404). Obligatorio con LIVEMODE=true y distinto de PORT.
INTERNAL_PORT=3001
# Personas distintas que aprueban cada liquidación antes de que tesorería la pague (2 o más con LIVEMODE=true)
PAYOUT_APPROVALS_REQUIRED=2
# Peticiones por minuto: API por llave, checkout y panel por IP
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_API_IP_PER_MIN=3000
RATE_LIMIT_CHECKOUT_PER_MIN=120
RATE_LIMIT_DASHBOARD_PER_MIN=300
