# Entorno de desarrollo (sandbox). Sin secretos reales: se versiona a propósito.
# Para producción usar .env.example como base, con valores propios y COOKIE_SECURE=true.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pasarela
REDIS_URL=redis://localhost:6379
INTERNAL_API_TOKEN=dev-internal-token
PORT=3000
LIVEMODE=false
FX_PAYOUT_SPREAD_BPS=120
FX_MAX_RATE_AGE_SECONDS=21600
PUBLIC_BASE_URL=http://localhost:3000
OTHER_MODE_DASHBOARD_URL=
# http sin TLS en local: cookies sin Secure y webhooks a http:// y a la red interna (p. ej. un receptor en tu máquina)
COOKIE_SECURE=false
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE=true
TRUST_PROXY=
# dev-jobs: par:fuente:tasa (ficticias)
DEV_FX_RATES=USD/VES:BCV:36.5,USDT/VES:BINANCE_P2P:37.2,USD/USDT:EXCHANGE:1.0005
FX_REFRESH_SECONDS=3600
EXPIRE_EVERY_SECONDS=60
