DATABASE_URL=postgres://postgres:postgres@localhost:5432/pasarela
REDIS_URL=redis://localhost:6379
INTERNAL_API_TOKEN=cambia-esto
PORT=3000
# false = sandbox (solo llaves sk_test_/pk_test_), true = producción (solo llaves live). Cada uno con su propia base.
LIVEMODE=false
# Spread cambiario al convertir liquidaciones (120 = 1,2 %)
FX_PAYOUT_SPREAD_BPS=120
FX_MAX_RATE_AGE_SECONDS=21600
# URL pública del sitio (links de pago y checkout). Sin definir, se usa la del pedido.
PUBLIC_BASE_URL=https://pagos.ejemplo.com
# Dashboard del otro modo (sandbox ↔ producción) para el selector "modo de prueba"
OTHER_MODE_DASHBOARD_URL=
# Solo desarrollo local en http: cookies sin Secure, webhooks a http:// y a la red interna
COOKIE_SECURE=true
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE=false
# Detrás de un balanceador, para la IP real en los límites de intentos (p. ej. 1)
TRUST_PROXY=
