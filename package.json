{
  "name": "pasarela-core",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo transaccional: ledger de doble partida multi-moneda y máquina de estados de PaymentIntent",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
